# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# IDE / OS
.idea/
.vscode/
.DS_Store

# 데이터·모델 (용량이 커서 커밋하지 않음, 스크립트로 내려받거나 생성)
data/*
!data/README.md

# 실험 결과: 요약(config, env, summary)만 커밋하고 원시 로그는 제외
**/experiments/**/logs/
**/experiments/**/models/*

# 과제 명세 원본 (저작권·공개 전환 대비, 각자 로컬 보관)
docs/00_spec/*.pdf

# Frontend
node_modules/

# 조원 폴더의 데이터, 모델 파일, 노트북 체크포인트
members/*/data/*
!members/*/data/README.md
*.pt
.ipynb_checkpoints/

# 서버 경유 실행의 서버 원시 로그와 전체 상태 덤프 (라운드·제외 요약 server_rounds.csv, exclusions.csv는 커밋)
experiments/**/server/server.log
experiments/**/server_status.json

# 대시보드 실행형(web/app.py)의 시연 결과
experiments/live/

# 원인 분석 재실험(reports/analysis/원인분석.md)의 출발 모델만 커밋 (명세: 재실행에 필요한 모델 상태)
!experiments/4_main/baseline-attack-fedavg-s[012]/models/round_00[05].pt
!experiments/4_main/delay-attack-fedavg-s[012]/models/round_00[05].pt
